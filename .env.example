# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# LLM model served by Groq (see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Sentence-Transformers embedding model (downloaded from Hugging Face on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Filesystem paths (relative to project root)
RAW_PDF_DIR=data/raw
PROCESSED_DIR=data/processed
VECTOR_STORE_DIR=vector_store
